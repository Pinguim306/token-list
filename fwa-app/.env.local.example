# Deployed contract addresses (set after running fwa-protocol/scripts/deploy.js)
# HyperEVM: mainnet (999) is the default — the demo checkout transacts on real
# HyperEVM. Set testnet for chain 998.
NEXT_PUBLIC_CHAIN=mainnet            # mainnet (56, default) | testnet (97)
NEXT_PUBLIC_POOL_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BACKING_TOKEN=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_NFT_COLLECTION=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_FWA_TOKEN=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_EMITTER=0x0000000000000000000000000000000000000000
# EquityBasket — enables live wrap/unwrap of tokenized equities on /app/baskets
NEXT_PUBLIC_BASKET_ADDRESS=0x0000000000000000000000000000000000000000
# KeeperHashChainAdapter — enables the live keeper state on /app/randomness
NEXT_PUBLIC_ADAPTER_ADDRESS=0x0000000000000000000000000000000000000000
# Optional: USD prices for equity tokens (JSON map, address -> price per whole
# token). Drives basket valuation until an on-chain/indexer price feed exists.
# NEXT_PUBLIC_EQUITY_PRICES={"0xTSLAon…":"300","0xNVDAon…":"100","0xSPCXD…":"200"}

# Optional: a running fwa-indexer (Ponder). When set, history screens read
# indexed events instead of fanning out one RPC call per record. Leave empty to
# read the pool directly — the app works either way.
# NEXT_PUBLIC_INDEXER_URL=http://localhost:42069
