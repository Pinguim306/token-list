# RPC + deployed addresses for indexing (HyperEVM — testnet 998 by default;
# set CHAIN_ID=999 and a mainnet RPC for HyperEVM mainnet).
#
# The public /evm endpoints are NOT archival (Hyperliquid prunes old blocks
# ~every 12h, and rpc.hyperliquid.xyz has no /nanoreth path — it 404s). Use an
# archival endpoint — QuickNode, Chainstack's /nanoreth path, or a self-hosted
# nanoreth node — or the backfill breaks once the deploy block ages out.
# Fill these from the JSON that scripts/deploy.js prints. Any address left at
# the zero default is simply not indexed — an incomplete deployment is fine.
CHAIN_ID=998
PONDER_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
POOL_ADDRESS=0x0000000000000000000000000000000000000000       # deploy.js -> pool
EMITTER_ADDRESS=0x0000000000000000000000000000000000000000    # deploy.js -> emitter
BASKET_ADDRESS=0x0000000000000000000000000000000000000000     # deploy.js -> basket
ADAPTER_ADDRESS=0x0000000000000000000000000000000000000000    # deploy.js -> adapter (keeper variant)
# REQUIRED on public HyperEVM RPCs: the block the stack was deployed at (the
# pruned public endpoints cannot serve genesis, and the config refuses to start
# from 0 against them). Find it on the explorer for any address above.
START_BLOCK=0
