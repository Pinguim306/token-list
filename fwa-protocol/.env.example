# RPC overrides (defaults point at the public HyperEVM endpoints; note the
# public /evm RPCs are pruned ~every 12h — use a provider for anything archival)
HYPEREVM_RPC=https://rpc.hyperliquid.xyz/evm
HYPEREVM_TESTNET_RPC=https://rpc.hyperliquid-testnet.xyz/evm
# Contract verification (mainnet 999 only — Etherscan V2 unified API; testnet
# 998 is not covered, use Sourcify/Purrsec per the runbook)
ETHERSCAN_API_KEY=
# Legacy chains kept for portability
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
RH_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
# Deployer secret (NEVER commit a real value)
DEPLOYER_MNEMONIC=
